{
  "name": "desktop-continuity",
  "version": "0.1.0",
  "private": true,
  "description": "Records Codex desktop activity through documented hooks and serves a read-only checkpoint to Claude Desktop over MCP.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "install-integrations": "node scripts/install.mjs",
    "check-limits": "node scripts/check-limits.mjs",
    "check-takeover": "node scripts/check-takeover.mjs",
    "check-capsule": "node scripts/check-capsule.mjs",
    "watch": "node src/watch.mjs",
    "build": "node scripts/build.mjs",
    "build:mcpb": "node scripts/build.mjs && mcpb validate desktop-extension/manifest.json && mcpb pack desktop-extension dist/desktop-continuity.mcpb",
    "check-dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "esbuild": "0.28.2"
  }
}
